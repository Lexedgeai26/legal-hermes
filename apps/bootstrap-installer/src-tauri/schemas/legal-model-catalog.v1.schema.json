{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexedge.ai/schemas/legal-model-catalog.v1.schema.json",
  "title": "LexEdge Legal Model Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "friendlyName",
        "ollamaModel",
        "minimumRamGb",
        "recommendedRamGb",
        "downloadSizeGb",
        "operationalContextTokens",
        "targetTps",
        "legalBenchmark"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "friendlyName": { "type": "string", "minLength": 1 },
        "ollamaModel": { "type": "string", "minLength": 1 },
        "llmfitAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "enabled": { "type": "boolean", "default": true },
        "retired": { "type": "boolean", "default": false },
        "minimumRamGb": { "$ref": "#/$defs/nonNegativeNumber" },
        "recommendedRamGb": { "$ref": "#/$defs/nonNegativeNumber" },
        "minimumVramGb": { "$ref": "#/$defs/nonNegativeNumber" },
        "requiresGpu": { "type": "boolean", "default": false },
        "requiredBackend": { "type": ["string", "null"], "minLength": 1 },
        "downloadSizeGb": { "$ref": "#/$defs/nonNegativeNumber" },
        "operationalContextTokens": { "type": "integer", "minimum": 1 },
        "targetTps": { "$ref": "#/$defs/nonNegativeNumber" },
        "legalBenchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved", "score", "version"],
          "properties": {
            "approved": { "type": "boolean" },
            "score": { "type": "number", "minimum": 0, "maximum": 100 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
