{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexedge.ai/schemas/component-manifest.v1.schema.json",
  "title": "LexEdge Signed Component Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "channel", "issuedAt", "expiresAt", "components"],
  "properties": {
    "schemaVersion": { "const": 1 }, "releaseId": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["development", "canary", "stable", "enterprise"] }, "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "platform", "architecture", "url", "sizeBytes", "sha256", "license", "noticePath"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["windows", "macos", "linux"] }, "architecture": { "enum": ["x64", "arm64"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "license": { "type": "string", "minLength": 1 },
          "noticePath": { "type": "string", "minLength": 1 }, "minimumOsVersion": { "type": ["string", "null"] },
          "authenticodeRequired": { "type": "boolean", "default": false }, "rollbackVersion": { "type": ["string", "null"] }
        }
      }
    }
  }
}
