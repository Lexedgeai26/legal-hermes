{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexedge.ai/schemas/hardware.v1.schema.json",
  "title": "LexEdge Normalized Hardware Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "os", "cpu", "memory", "gpus", "storage", "power", "existingRuntime"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "os": { "$ref": "#/$defs/os" },
    "cpu": { "$ref": "#/$defs/cpu" },
    "memory": { "$ref": "#/$defs/memory" },
    "gpus": { "type": "array", "items": { "$ref": "#/$defs/gpu" } },
    "storage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/storage" } },
    "power": { "$ref": "#/$defs/power" },
    "existingRuntime": { "$ref": "#/$defs/runtime" }
  },
  "$defs": {
    "nonNegative": { "type": "number", "minimum": 0 },
    "os": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "arch"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "build": { "type": "string" }, "arch": { "enum": ["x64", "arm64"] } }
    },
    "cpu": {
      "type": "object", "additionalProperties": false,
      "required": ["vendor", "model", "physicalCores", "logicalCores"],
      "properties": { "vendor": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "physicalCores": { "type": "integer", "minimum": 1 }, "logicalCores": { "type": "integer", "minimum": 1 } }
    },
    "memory": {
      "type": "object", "additionalProperties": false, "required": ["totalGb", "availableGb"],
      "properties": { "totalGb": { "$ref": "#/$defs/nonNegative" }, "availableGb": { "$ref": "#/$defs/nonNegative" } }
    },
    "gpu": {
      "type": "object", "additionalProperties": false, "required": ["vendor", "model", "dedicatedVramGb", "backend"],
      "properties": { "vendor": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "dedicatedVramGb": { "$ref": "#/$defs/nonNegative" }, "driverVersion": { "type": ["string", "null"] }, "backend": { "type": ["string", "null"] } }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["volume", "freeGb", "type"],
      "properties": { "volume": { "type": "string", "minLength": 1 }, "freeGb": { "$ref": "#/$defs/nonNegative" }, "type": { "type": "string", "minLength": 1 } }
    },
    "power": {
      "type": "object", "additionalProperties": false, "required": ["isLaptop", "onBattery"],
      "properties": { "isLaptop": { "type": "boolean" }, "onBattery": { "type": "boolean" } }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["found", "version", "port", "managedByProduct"],
      "properties": { "found": { "type": "boolean" }, "version": { "type": ["string", "null"] }, "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }, "managedByProduct": { "type": "boolean" } }
    }
  }
}
